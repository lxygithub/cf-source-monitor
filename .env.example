# ============================================
# 数据库连接配置（二选一）
# ============================================

# ── 方案 A：SQLite（默认，零配置，单机部署推荐）──
# 注意：相对路径基于 prisma schema 所在目录解析，生产环境建议使用绝对路径
DATABASE_URL=file:./db/custom.db

# ── 方案 B：MySQL（云数据库 / 共享实例推荐）──
# 使用前需将 prisma/schema.prisma 中的 provider 从 "sqlite" 改为 "mysql"
# 完整步骤与避坑指南见 DEPLOY.md
#
# 注意：密码中的特殊字符必须做 URL 编码！
#   #  →  %23      [  →  %5B      ]  →  %5D
#   @  →  %40      :  →  %3A      /  →  %2F
#
# DATABASE_URL="mysql://用户名:URL编码后的密码@主机地址:端口/cf_monitor?connection_limit=10"
#
# 示例（占位符，请替换为你的真实信息）：
# DATABASE_URL="mysql://myuser:%23p%5Bss@db.example.com:34632/cf_monitor?connection_limit=10"
